ANTHROPIC_API_KEY=paste-your-key-here
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=lumen-assets
SESSION_COOKIE_SECURE=false
VISUALASSISTCAM_DATA_DIR=~/VisualAssistCam_Data

# Anonymous API quota shared across costly/upload endpoints.
ANON_API_RATE_LIMIT=10 per hour; 50 per day

# Read-only JSON routes can be more permissive.
READ_API_RATE_LIMIT=120 per hour

# Non-AI session management writes can be looser than uploads/Claude calls.
WRITE_API_RATE_LIMIT=30 per hour; 200 per day

# 5 MB decoded image limit, 8 MB request cap for base64 JSON payloads.
MAX_IMAGE_BYTES=5242880
MAX_REQUEST_BYTES=8388608
DAILY_ANALYSES_LIMIT=20
MONTHLY_ANALYSES_LIMIT=200
DAILY_UPLOAD_LIMIT=30
ANALYSIS_CACHE_TTL=600
BOARD_CACHE_TTL=600

# Optional production settings:
# REQUIRE_DURABLE_STORAGE=true
# ALLOW_LOCAL_SESSION_FALLBACK=false
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# RATELIMIT_STRATEGY=fixed-window
# TRUST_PROXY_COUNT=1
# Published store listing URLs. Leave blank until each listing is live.
LUMEN_APP_STORE_URL=
LUMEN_PLAY_STORE_URL=
LUMEN_MAC_DOWNLOAD_URL=/static/downloads/Lumen-macOS.zip
